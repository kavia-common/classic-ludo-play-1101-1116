# === Ludo Backend Environment Variables ===

# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=true

# Frontend and backend URLs
BACKEND_URL=https://your-domain:3001
FRONTEND_URL=https://your-domain:3000

# CORS configuration
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://your-domain:3000,http://localhost:3000,http://localhost:4000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600

# Database - path to the SQLite database file
# SQLITE_DB=/path/to/database/myapp.db

# WebSocket URL (for future use)
# WS_URL=ws://your-domain:3001/ws

# Rate limiting
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=100
REQUEST_TIMEOUT_MS=30000
