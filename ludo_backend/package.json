{
    "name": "ludo-backend",
    "version": "1.0.0",
    "description": "Ludo Game Backend - REST API for game logic, dice rolls, token movement, and game state management",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "jest",
        "lint": "eslint .",
        "generate-openapi": "node generate_openapi.js"
    },
    "dependencies": {
        "better-sqlite3": "^11.7.0",
        "cors": "2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "eslint": "^9.24.0",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.1"
    },
    "nodemonConfig": {
        "watch": ["src"],
        "ignore": [
            "node_modules",
            "package.json",
            "package-lock.json",
            "*.lock",
            "*.log",
            "*.md",
            ".git",
            "dist",
            "build"
        ],
        "ext": "js,json"
    }
}
